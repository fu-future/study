{
  "name": "ai-study-coach",
  "version": "0.1.0",
  "private": true,
  "description": "AI 高中学习教练 — 以学习者为中心的智能学习系统（MVP）",
  "engines": {
    "node": ">=20.9.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "setup": "prisma generate && prisma migrate deploy && prisma db seed",
    "pg:schema": "node scripts/make-postgres-schema.mjs",
    "pg:migration:sql": "node scripts/make-postgres-schema.mjs && node scripts/generate-postgres-migration.mjs",
    "prepare:e2e": "node scripts/reset-e2e-distdir.mjs",
    "pretest:e2e": "npm run prepare:e2e",
    "lan": "node scripts/serve-lan.mjs",
    "serve": "next start -H ::",
    "icons": "node scripts/generate-icons.mjs",
    "backup": "node scripts/backup-data.mjs",
    "net:check": "node scripts/diagnose-network.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "katex": "0.19.0",
    "lucide-react": "1.58.0",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss-animate": "1.0.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.18.13",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "autoprefixer": "10.4.21",
    "eslint": "9.39.0",
    "eslint-config-next": "15.5.28",
    "postcss": "8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
