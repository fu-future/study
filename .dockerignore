.env
.env.local
.env.*.local

# 版本库与编辑器
.git
.gitignore
.github
.vscode
.idea

# 测试与文档（运行时不需要）
e2e
playwright-report
test-results
coverage
*.md

# 其他
npm-debug.log*
Dockerfile
docker-compose.yml
.dockerignore
