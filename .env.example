# =============================================================================
# AI 高中学习教练 — 环境变量模板
# 复制一份为 `.env` 后填写。切勿把真实密钥提交到版本库。
# 所有变量在启动时经 src/lib/env.ts 用 Zod 校验，校验失败直接报错退出。
# =============================================================================

# -----------------------------------------------------------------------------
# 数据库
# -----------------------------------------------------------------------------
# 第一阶段（默认）：SQLite，零外部依赖，只需 Node.js + npm。
#   注意：Prisma 中 SQLite 的相对路径是**相对 schema.prisma 所在目录**解析的，
#   所以 `file:../.data/dev.db` 会落在 <项目根>/.data/dev.db。
DATABASE_URL=file:../.data/dev.db

# 后续可选部署（**不要**在第一阶段开启）：PostgreSQL
# 迁移到 PostgreSQL 不是改一行 DATABASE_URL 就能完成的，
# 详见 docs/DATABASE.md「SQLite → PostgreSQL 迁移指南」。
# DATABASE_URL=postgresql://study:study@localhost:5432/study_coach?schema=public

# -----------------------------------------------------------------------------
# AI Provider（仅服务端读取，绝不下发到浏览器）
# AI_PROVIDER 取值：mock | deepseek | openai-compatible
#   - mock：不需要任何 Key，用于本地开发与自动化测试
#   - deepseek：内置预设（base url = https://api.deepseek.com）
#   - openai-compatible：任意 OpenAI 兼容端点，需自行填 AI_BASE_URL / AI_MODEL
# -----------------------------------------------------------------------------
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# 视觉（图片理解）模型，单独指定；留空表示当前 provider 不具备图片理解能力，
# analyzeImage() 会返回明确的「不支持」错误，而不是假装成功。
AI_VISION_MODEL=
AI_TIMEOUT_MS=30000

# 模型调用可靠性
AI_MAX_RETRIES=2
AI_MAX_INPUT_CHARS=24000
AI_MAX_OUTPUT_TOKENS=2048
# 限流：每用户每分钟允许的 AI 请求数（滑动窗口，进程内实现）
AI_RATE_LIMIT_PER_MINUTE=20

# -----------------------------------------------------------------------------
# 学习资源检索 Provider（第二阶段功能）
# 取值：internal-only（默认，最安全）| tavily | custom-json
#   - internal-only：只用管理员维护并核验过的资源库
#   - tavily / custom-json：外部搜索结果一律标记为「未核验」，且不编造内容
# -----------------------------------------------------------------------------
RESOURCE_SEARCH_PROVIDER=internal-only
RESOURCE_SEARCH_API_KEY=
RESOURCE_SEARCH_BASE_URL=
RESOURCE_SEARCH_TIMEOUT_MS=8000

# -----------------------------------------------------------------------------
# 应用
# -----------------------------------------------------------------------------
APP_URL=http://localhost:3000
# 会话签名密钥（≥32 字符）。生成：
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-32-byte-hex-string-min-32-chars

# 上传限制
UPLOAD_MAX_BYTES=5242880
# 本地文件存储目录（相对工作区根目录）
UPLOAD_DIR=.data/uploads
# 学习数据保留策略（天）——仅用于文档与人工清理，项目不做自动删除
DATA_RETENTION_DAYS=730

# 是否允许自助注册（创建完账号后可改回 false）
ALLOW_SELF_SIGNUP=true

# 日志级别：debug | info | warn | error
LOG_LEVEL=info
